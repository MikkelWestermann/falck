---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import opencodeLogo from '../../assets/opencode.svg';
---

<Layout
  title="Falck | Model orchestration"
  description="Bring your own models and keep orchestration local with OpenCode inside Falck."
  theme="dark"
  navVariant="tech"
>
  <section class="relative overflow-hidden pt-24 pb-20">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 backdrop-grid opacity-50"></div>
      <div class="absolute -top-20 left-[12%] h-[320px] w-[320px] rounded-full bg-cyan-400/30 blur-[140px] glow-pulse"></div>
      <div class="absolute bottom-[-25%] right-[6%] h-[420px] w-[420px] rounded-full bg-sky-400/30 blur-[160px] float-soft"></div>
    </div>

    <div class="container mx-auto px-6">
      <div class="max-w-3xl space-y-6 reveal">
        <span class="inline-flex items-center gap-2 rounded-full bg-slate-950/70 px-4 py-2 text-xs uppercase tracking-[0.3em] text-slate-300 border border-slate-800/80">
          Model orchestration
        </span>
        <h1 class="text-4xl sm:text-5xl font-semibold text-white">Bring your own models, keep the workflow local</h1>
        <p class="text-lg text-slate-300">
          Falck uses OpenCode to orchestrate models, tools, and workflows on your machine. You pick the provider, Falck
          keeps the experience consistent for every teammate. Swap models without rewriting workflows or summoning new
          permissions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href="/tech/runtime">See runtime details</Button>
          <Button href="/tech/download" variant="secondary">Download Falck</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-6 py-20">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] items-center">
      <div class="space-y-4 reveal">
        <p class="text-xs uppercase tracking-[0.4em] text-cyan-400">OpenCode</p>
        <h2 class="text-2xl font-semibold text-white">Consistent orchestration, flexible providers</h2>
        <p class="text-slate-300">
          OpenCode keeps models, tools, and commands organized. Switch providers without reworking the workflow and keep
          everything local-first. Your stack can evolve without breaking the experience for everyone else.
        </p>
        <div class="grid gap-3 text-sm text-slate-300">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            Bring your own model keys
          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            Local orchestration, fewer surprises
          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            Same guardrails for every teammate
          </div>
        </div>
      </div>
      <div class="app-window reveal-delay-1">
        <div class="app-window-bar">
          <span>Falck Desktop</span>
          <span>OpenCode</span>
        </div>
        <div class="p-4 space-y-3">
          <div class="flex items-center justify-between text-xs uppercase tracking-[0.3em] text-slate-400">
            <span>Providers</span>
            <span class="text-cyan-300">Connected</span>
          </div>
          <div class="grid gap-2">
            <div class="surface-muted px-4 py-3 text-sm">
              <p class="font-semibold text-white">OpenCode</p>
              <p class="mt-1 text-xs text-slate-400">Claude, GPT, Gemini, friends</p>
            </div>
            <div class="surface-muted px-4 py-3 text-sm">
              <p class="font-semibold text-white">Custom</p>
              <p class="mt-1 text-xs text-slate-400">OpenAI-compatible endpoint</p>
            </div>
            <div class="surface-dark px-4 py-3 text-sm">
              <p class="font-semibold">Routing</p>
              <p class="mt-1 text-xs text-cyan-100/70">Local-first orchestration</p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800/70 bg-slate-950 px-4 py-3 text-xs text-slate-400">
            No lock-in. Just models doing model things.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-6 py-20">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="surface p-6 reveal">
        <p class="text-xs uppercase tracking-[0.4em] text-cyan-400">Flexibility</p>
        <h3 class="mt-3 text-xl font-semibold text-white">Swap providers fast</h3>
        <p class="mt-2 text-sm text-slate-300">
          Add multiple providers and switch per project. Falck keeps the experience consistent.
        </p>
      </div>
      <div class="surface p-6 reveal-delay-1">
        <p class="text-xs uppercase tracking-[0.4em] text-slate-400">Control</p>
        <h3 class="mt-3 text-xl font-semibold text-white">Local-first by default</h3>
        <p class="mt-2 text-sm text-slate-300">
          Keep orchestration on your machine and your data out of mystery clouds.
        </p>
      </div>
      <div class="surface p-6 reveal-delay-2">
        <p class="text-xs uppercase tracking-[0.4em] text-slate-400">Consistency</p>
        <h3 class="mt-3 text-xl font-semibold text-white">One workflow, many models</h3>
        <p class="mt-2 text-sm text-slate-300">
          Same steps for everyone, regardless of the provider behind the scenes.
        </p>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-6 pb-28">
    <div class="surface p-10 md:p-12 text-center reveal">
      <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Keep exploring</p>
      <h2 class="mt-4 text-3xl font-semibold text-white">Guardrails plus flexibility</h2>
      <p class="mt-4 text-slate-300 max-w-2xl mx-auto">
        Falck keeps the workflow stable while you choose the models and infrastructure that fit your team.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/tech/runtime">Runtime details</Button>
        <Button href="/tech/workflow" variant="secondary">Workflow safety</Button>
      </div>
    </div>
  </section>
</Layout>
